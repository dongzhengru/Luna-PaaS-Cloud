{
  "name": "luna-paas-cloud-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \"*.{json,ts,html}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" \"*.{json,ts,html}\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.577.0",
    "pinia": "3.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.21",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "6.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vue-tsc": "3.0.6"
  }
}
