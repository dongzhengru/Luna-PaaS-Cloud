MYSQL_PASSWORD=replace-with-a-long-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-password
# Generate: openssl rand -base64 32
PAAS_MASTER_KEY=
PAAS_PUBLIC_URL=https://paas.example.com
PAAS_FRONTEND_URL=https://paas.example.com
PAAS_SECURE_COOKIES=true
PAAS_HTTP_PORT=8080

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://paas.example.com/api/auth/callback
OAUTH_SCOPE=openid profile
OAUTH_PHONE_PATH=phone

ACR_REGISTRY=your-registry.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=your-namespace
